# ─── AIvance 도입 문의 폼 — Brevo API 설정 ────────────────────────────────
# 이 파일을 복사해 .env 를 만들고 값을 채우세요:  cp .env.example .env
# .env 는 절대 커밋하지 않습니다 (.gitignore 에 등록됨).

# Brevo(구 Sendinblue) — https://app.brevo.com/settings/keys/api 에서 발급
# 무료 플랜: 하루 300통. Gmail SMTP 개인 계정을 문의 폼 발송에 쓰다가 스팸 남용으로
# 일일 한도가 소진되는 문제가 반복돼 API 기반 발송 전용 서비스로 전환했습니다.
BREVO_API_KEY=여기에_Brevo_API_Key

# 메일 발신/수신
# MAIL_FROM 은 Brevo에 인증된 발신 도메인/이메일이어야 합니다
# (Brevo 대시보드 → Senders, Domains 에서 도메인 인증 후 사용).
MAIL_FROM=noreply@aivance.kr
MAIL_FROM_NAME="AIvance 홈페이지 문의"
MAIL_TO=advisor@aivance.kr

# CORS 허용 오리진 — 폼이 올라간 실제 도메인만 콤마로 나열 (와일드카드 * 금지).
# 목록에 없는 Origin 은 헤더 자체를 내려주지 않아 브라우저가 요청을 차단합니다.
ALLOWED_ORIGIN=https://aivance.kr,https://www.aivance.kr

# Google reCAPTCHA v3 — 봇 차단 (https://www.google.com/recaptcha/admin → v3 등록)
# Site Key(공개값)는 index.html / consulting.html의 recaptcha api.js 스크립트 URL과
# js/contact.js의 RECAPTCHA_SITE_KEY 상수, 두 군데 모두 실제 값으로 바꿔야 합니다.
# Secret Key(비공개값)만 여기 .env 에 넣으세요 — 절대 커밋 금지.
RECAPTCHA_SECRET_KEY=여기에_reCAPTCHA_Secret_Key

# ─── Slack 알림 ───────────────────────────────────────────────────────────
# 문의가 접수되면 이 Incoming Webhook 으로 알림을 보냅니다.
# Slack → Apps → Incoming Webhooks → Add to Slack → 채널 선택 후 URL 복사.
# 비워두면 알림만 건너뛰고 저장은 정상 동작합니다 (로컬 개발용).
SLACK_WEBHOOK_URL=

# Slack 알림의 "관리자 페이지에서 열기" 버튼이 가리킬 사이트 주소 (끝 슬래시 없이).
# 비워두면 버튼 없이 알림만 보냅니다.
ADMIN_BASE_URL=https://aivance.kr

# ─── 관리자 페이지 (admin.php) ────────────────────────────────────────────
# 해시 생성:  php tools/admin-hash.php
# ⚠ ADMIN_PASSWORD_HASH 는 반드시 '작은따옴표'로 감쌉니다.
#   해시에 들어있는 $ 를 phpdotenv 가 변수 참조로 해석해 값이 깨지기 때문입니다.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH='여기에_password_hash_결과'
